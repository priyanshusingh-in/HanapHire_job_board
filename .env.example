# Copy this file to .env and fill in real values.
# A single .env file is read by both Next.js (app runtime) and the Prisma CLI
# (via prisma.config.ts's `import "dotenv/config"`) — no .env.local needed.

# --- Supabase project settings -> https://supabase.com/dashboard/project/_/settings/api ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres connection strings -> Supabase dashboard -> Project Settings -> Database ---
# DATABASE_URL: pooled connection (Transaction pooler, port 6543) — used by the Next.js app at request time.
# DIRECT_URL:   direct connection (port 5432) — used by Prisma migrations and by pg-boss (needs session-level LISTEN/NOTIFY).
DATABASE_URL=
DIRECT_URL=

# --- AI providers (comma-separated keys per provider; AI_PROVIDERS sets fallback order) ---
# All four expose an OpenAI-compatible /chat/completions endpoint, so one
# generic client handles all of them (see src/lib/ai/agent-llm-client.ts).
# Drop a provider from AI_PROVIDERS entirely if you skip getting its key
# (e.g. Qwen/DashScope can require Alibaba Cloud account verification) —
# the client degrades gracefully to whichever providers are configured.
AI_PROVIDERS=gemini,groq,qwen,openrouter
GEMINI_API_KEYS=
GROQ_API_KEYS=
QWEN_API_KEYS=
OPENROUTER_API_KEYS=
# Optional model overrides — free-tier model IDs change often, verify current ones before relying on the defaults baked into agent-llm-client.ts.
GEMINI_MODEL=
GROQ_MODEL=
QWEN_MODEL=
OPENROUTER_MODEL=

# --- Email (Resend) — sandbox mode until a domain is verified ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- Background job tick auth (GitHub Actions -> POST /api/jobs/tick) ---
JOBS_TICK_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
